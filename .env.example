# ==============================
# TASKFLOW LOCAL DEVELOPMENT
# ==============================
# Copy this file to .env if you do not already have one.
# These are local Docker Compose credentials only.

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_local_password
DATABASE_URL=postgresql+psycopg://taskflow:taskflow_local_password@db:5432/taskflow
IMAGE_TAG=local
